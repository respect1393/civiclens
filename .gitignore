# Root safety net. Each project (backend/, mobile/, admin/) also has its own
# .gitignore; this file only catches the common artifacts when the whole tree is
# tracked from the root.

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files and secrets (keep the documented examples).
.env
.env.*
!.env.example

# Databases and their journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Build output
dist/
build/
coverage/

# Flutter / Dart
.dart_tool/
.flutter-plugins-dependencies
**/doc/api/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.iml
*.log
*.tmp
*.temp
