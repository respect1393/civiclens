# CIVICLENS backend — local development example.
#
# Copy this file to `.env` and replace the placeholder values with your own.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Prisma (v7) reads the database URL through prisma.config.ts, which resolves
# the DATABASE_URL environment variable. The runtime Prisma driver adapter in
# src/db.ts reads the same variable, so one value configures both.

# SQLite development database, relative to the backend/ working directory.
# A brand-new file is created the first time you run `npm run db:init`.
DATABASE_URL="file:./dev.db"

# HTTP port the API listens on.
PORT=3000

# Where uploaded report images are stored. Relative paths are resolved from the
# backend/ working directory. The directory is created automatically on start.
UPLOAD_DIR="./uploads"

# Secret used to sign and verify JWTs.
#
# Generate a UNIQUE value for your machine — never reuse someone else's and
# never commit it. Any of these works:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 48
#
# It must be at least 32 characters; the server refuses to start otherwise.
JWT_SECRET="replace-me-with-a-unique-secret-at-least-32-characters-long"
