generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CITIZEN
  ADMIN
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ReportCategory {
  ROADS
  STREETLIGHTS
  WATER
  WASTE
  DRAINAGE
  SAFETY
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CITIZEN)
  reports      Report[]
  adminNotes   AdminNote[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Report {
  id             String          @id @default(cuid())
  title          String
  description    String
  category       ReportCategory
  status         ReportStatus    @default(SUBMITTED)
  area           String
  address        String
  landmark       String?
  latitude       Float?
  longitude      Float?
  photoPath      String?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  statusHistory  StatusHistory[]
  adminNotes     AdminNote[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([category])
  @@index([userId])
  @@index([createdAt])
}

model StatusHistory {
  id        String       @id @default(cuid())
  reportId  String
  oldStatus ReportStatus?
  newStatus ReportStatus
  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedAt DateTime     @default(now())

  @@index([reportId, changedAt])
}

model AdminNote {
  id        String   @id @default(cuid())
  reportId  String
  adminId   String
  content   String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
}
