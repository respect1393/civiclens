import express from "express";
import cors from "cors";
import helmet from "helmet";
import { prisma } from "./db";
import { z } from "zod";

const app = express();

// Zod schema for report creation
const reportCreateSchema = z.object({
  title: z.string().min(1, "Title is required"),
  description: z.string().min(1, "Description is required"),
  category: z.enum(["ROADS", "STREETLIGHTS", "WATER", "WASTE", "DRAINAGE", "SAFETY"]),
  area: z.string().min(1, "Area is required"),
  address: z.string().min(1, "Address is required"),
  landmark: z.string().optional(),
  latitude: z.number().min(-90).max(90).optional(),
  longitude: z.number().min(-180).max(180).optional(),
  userId: z.string().min(1, "User ID is required"),
});
const PORT = Number(process.env.PORT) || 3000;

app.use(helmet());
app.use(cors());
app.use(express.json({ limit: "1mb" }));

app.get("/api/health", (_req, res) => {
  res.json({
    status: "ok",
    service: "civiclens-backend",
  });
});

// POST /api/reports - Create a new report
app.post("/api/reports", async (req, res) => {
  try {
    // Validate request body
    const result = reportCreateSchema.safeParse(req.body);
    if (!result.success) {
      return res.status(400).json({
        error: "Invalid request data",
        details: result.error.format(),
      });
    }

    const {
      title,
      description,
      category,
      area,
      address,
      landmark,
      latitude,
      longitude,
      userId,
    } = result.data;

    // Verify that userId refers to an existing user
    const userExists = await prisma.user.findUnique({
      where: { id: userId },
      select: { id: true },
    });

    if (!userExists) {
      return res.status(404).json({
        error: "User not found",
      });
    }

    // Create the report
    const report = await prisma.report.create({
      data: {
        title,
        description,
        category,
        area,
        address,
        landmark,
        latitude,
        longitude,
        userId,
      },
      include: {
        user: {
          select: {
            id: true,
            name: true,
            email: true,
          },
        },
      },
    });

    // Return HTTP 201 with the created report and safe citizen information
    res.status(201).json(report);
  } catch (error) {
    console.error("Error creating report:", error);
    res.status(500).json({
      error: "Internal server error",
    });
  }
});

// GET /api/reports - Retrieve reports with pagination
app.get("/api/reports", async (req, res) => {
  try {
    const page = Math.max(parseInt(req.query.page?.toString() ?? "1"), 1);
    const limit = Math.min(
      Math.max(parseInt(req.query.limit?.toString() ?? "20"), 1),
      100
    );
    const skip = (page - 1) * limit;

    // Get total count for pagination metadata
    const total = await prisma.report.count();

    // Get reports with associated citizen info, sorted newest first
    const reports = await prisma.report.findMany({
      skip,
      take: limit,
      orderBy: {
        createdAt: "desc",
      },
      include: {
        user: {
          select: {
            id: true,
            name: true,
            email: true,
          },
        },
      },
    });

    // Return consistent JSON response with reports and pagination metadata
    res.json({
      data: reports,
      pagination: {
        page,
        limit,
        total,
        totalPages: Math.ceil(total / limit),
      },
    });
  } catch (error) {
    console.error("Error fetching reports:", error);
    res.status(500).json({
      error: "Internal server error",
    });
  }
});

// GET /api/reports/:id - Retrieve one report by ID
app.get("/api/reports/:id", async (req, res) => {
  try {
    const { id } = req.params;

    const report = await prisma.report.findUnique({
      where: { id },
      include: {
        user: {
          select: {
            id: true,
            name: true,
            email: true,
          },
        },
      },
    });

    if (!report) {
      return res.status(404).json({
        error: "Report not found",
      });
    }

    res.json(report);
  } catch (error) {
    console.error("Error fetching report:", error);
    res.status(500).json({
      error: "Internal server error",
    });
  }
});

app.listen(PORT, () => {
  console.log(`CivicLens backend running at http://localhost:${PORT}`);
});
