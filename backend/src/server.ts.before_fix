import express from "express";
import cors from "cors";
import helmet from "helmet";
import { prisma } from "./db";
import { z } from "zod";
import bcrypt from "bcryptjs";
import jwt from "jsonwebtoken";

const app = express();

// Environment validation
const JWT_SECRET = process.env.JWT_SECRET;
if (!JWT_SECRET) {
  console.error("FATAL: JWT_SECRET is not defined in the environment");
  process.exit(1);
}
if (JWT_SECRET.length < 32) {
  console.error("FATAL: JWT_SECRET must be at least 32 characters long");
  process.exit(1);
}

const PORT = Number(process.env.PORT) || 3000;

// Middleware
app.use(helmet());
app.use(cors());
app.use(express.json({ limit: "1mb" }));

// Zod schemas
const registerSchema = z.object({
  name: z.string().min(1, "Name is required"),
  email: z.string().email("Invalid email address"),
  password: z.string().min(8, "Password must be at least 8 characters long"),
  state: z.string().min(1, "State is required"),
  district: z.string().min(1, "District is required"),
});

const loginSchema = z.object({
  email: z.string().email("Invalid email address"),
  password: z.string().min(1, "Password is required"),
});

const reportCreateSchema = z.object({
  title: z.string().min(1, "Title is required"),
  description: z.string().min(1, "Description is required"),
  category: z.enum(["ROADS", "STREETLIGHTS", "WATER", "WASTE", "DRAINAGE", "SAFETY"]),
  area: z.string().min(1, "Area is required"),
  address: z.string().min(1, "Address is required"),
  landmark: z.string().optional(),
  latitude: z.number().min(-90).max(90).optional(),
  longitude: z.number().min(-180).max(180).optional(),
});

// Extend Express Request type to include user
declare global {
  namespace Express {
    interface Request {
      user?: {
        id: string;
        email: string;
        role: string;
        state?: string | null;
        district?: string | null;
      };
    }
  }
}

// Authentication middleware
const authenticate = async (
  req: express.Request,
  res: express.Response,
  next: express.NextFunction
) => {
  const authHeader = req.headers.authorization;
  if (!authHeader?.startsWith("Bearer ")) {
    return res.status(401).json({ error: "Unauthorized" });
  }

  const token = authHeader.substring(7);
  try {
    const payload = jwt.verify(token, JWT_SECRET) as {
      id: string;
      email: string;
      role: string;
    };
    // Fetch fresh user data from DB to ensure we have latest state/district and role
    const user = await prisma.user.findUnique({
      where: { id: payload.id },
      select: {
        id: true,
        email: true,
        role: true,
        state: true,
        district: true,
      },
    });

    if (!user) {
      return res.status(401).json({ error: "Unauthorized" });
    }

    req.user = user;
    next();
  } catch (error) {
    return res.status(401).json({ error: "Unauthorized" });
  }
};

// Health endpoint
app.get("/api/health", (_req, res) => {
  res.json({
    status: "ok",
    service: "civiclens-backend",
  });
});

// Auth endpoints
app.post("/api/auth/register", async (req, res) => {
  try {
    // Validate input
    const result = registerSchema.safeParse(req.body);
    if (!result.success) {
      return res.status(400).json({
        error: "Invalid registration data",
        details: result.error.format(),
      });
    }

    const { name, email, password, state, district } = result.data;

    // Check if email already exists
    const existingUser = await prisma.user.findUnique({
      where: { email },
    });

    if (existingUser) {
      return res.status(400).json({
        error: "Email already registered",
      });
    }

    // Hash password
    const hashedPassword = await bcrypt.hash(password, 10);

    // Create user (role is always CITIZEN for public registration)
    const user = await prisma.user.create({
      data: {
        name,
        email,
        passwordHash: hashedPassword,
        role: "CITIZEN",
        state,
        district,
      },
      select: {
        id: true,
        name: true,
        email: true,
        state: true,
        district: true,
        role: true,
      },
    });

    // Generate JWT
    const token = jwt.sign(
      { id: user.id, email: user.email, role: user.role },
      JWT_SECRET,
      { expiresIn: "7d" }
    );

    res.status(201).json({
      user,
      token,
    });
  } catch (error) {
    console.error("Registration error:", error);
    res.status(500).json({ error: "Internal server error" });
  }
});

app.post("/api/auth/login", async (req, res) => {
  try {
    // Validate input
    const result = loginSchema.safeParse(req.body);
    if (!result.success) {
      return res.status(400).json({
        error: "Invalid login data",
        details: result.error.format(),
      });
    }

    const { email, password } = result.data;

    // Find user by email
    const user = await prisma.user.findUnique({
      where: { email },
    });

    if (!user) {
      // Generic error to prevent user enumeration
      return res.status(401).json({ error: "Invalid credentials" });
    }

    // Verify password
    const passwordValid = await bcrypt.compare(password, user.passwordHash);
    if (!passwordValid) {
      return res.status(401).json({ error: "Invalid credentials" });
    }

    // Generate JWT
    const token = jwt.sign(
      { id: user.id, email: user.email, role: user.role },
      JWT_SECRET,
      { expiresIn: "7d" }
    );

    // Return safe user object
    const safeUser = {
      id: user.id,
      name: user.name,
      email: user.email,
      state: user.state,
      district: user.district,
      role: user.role,
    };

    res.json({
      user: safeUser,
      token,
    });
  } catch (error) {
    console.error("Login error:", error);
    res.status(500).json({ error: "Internal server error" });
  }
});

// Report endpoints (protected)
app.post("/api/reports", authenticate, async (req, res) => {
  try {
    // Validate input
    const result = reportCreateSchema.safeParse(req.body);
    if (!result.success) {
      return res.status(400).json({
        error: "Invalid report data",
        details: result.error.format(),
      });
    }

    const {
      title,
      description,
      category,
      area,
      address,
      landmark,
      latitude,
      longitude,
    } = result.data;

    // Get authenticated user
    const user = req.user as {
      id: string;
      state: string | null;
      district: string | null;
    };

    // Ensure user has state and district (should be enforced at registration, but double-check)
    if (!user.state || !user.district) {
      return res.status(400).json({
        error: "User profile incomplete: state and district required",
      });
    }

    // Create report with authenticated user's ID and geographic info
    const report = await prisma.report.create({
      data: {
        title,
        description,
        category,
        area,
        address,
        landmark,
        latitude,
        longitude,
        userId: user.id,
        state: user.state,
        district: user.district,
      },
      include: {
        user: {
          select: {
            id: true,
            name: true,
            email: true,
          },
        },
      },
    });

    res.status(201).json(report);
  } catch (error) {
    console.error("Error creating report:", error);
    res.status(500).json({ error: "Internal server error" });
  }
});

// GET /api/reports - Retrieve reports with pagination and geographic filtering
app.get("/api/reports", authenticate, async (req, res) => {
  try {
    const user = req.user as {
      id: string;
      role: string;
      state: string | null;
      district: string | null;
    };

    // Safely parse pagination parameters
    const parsePage = (page: any) => {
      const num = Array.isArray(page) ? parseInt(page[0]) : parseInt(page);
      return isNaN(num) ? 1 : Math.max(num, 1);
    };
    const parseLimit = (limit: any) => {
      const num = Array.isArray(limit) ? parseInt(limit[0]) : parseInt(limit);
      return isNaN(num) ? 20 : Math.min(Math.max(num, 1), 100);
    };

    const page = parsePage(req.query.page);
    const limit = parseLimit(req.query.limit);
    const skip = (page - 1) * limit;

    // Build where clause based on user role
    let whereClause: any = {};

    if (user.role === "CITIZEN") {
      // Citizens can only see reports from their state
      if (!user.state) {
        // If user has no state, they see nothing
        whereClause = {
          state: null, // This will match no records since we treat null as unknown
        };
      } else {
        whereClause = {
          state: user.state,
          // If user has a district, filter by district too; otherwise, only state matters
          ...(user.district ? { district: user.district } : {}),
        };
      }
    }
    // Administrators see all reports (no geographic restrictions by default)

    // Get total count for pagination metadata
    const total = await prisma.report.count({ where: whereClause });

    // Get reports with associated citizen info, sorted newest first
    const reports = await prisma.report.findMany({
      where: whereClause,
      skip,
      take: limit,
      orderBy: {
        createdAt: "desc",
      },
      include: {
        user: {
          select: {
            id: true,
            name: true,
            email: true,
          },
        },
      },
    });

    // Return consistent JSON response with reports and pagination metadata
    res.json({
      data: reports,
      pagination: {
        page,
        limit,
        total,
        totalPages: Math.ceil(total / limit),
      },
    });
  } catch (error) {
    console.error("Error fetching reports:", error);
    res.status(500).json({ error: "Internal server error" });
  }
});

// GET /api/reports/:id - Retrieve one report by ID with authorization check
app.get("/api/reports/:id", authenticate, async (req, res) => {
  try {
    const { id } = req.params;
    const user = req.user as {
      id: string;
      role: string;
      state: string | null;
      district: string | null;
    };

    const report = await prisma.report.findUnique({
      where: { id },
      include: {
        user: {
          select: {
            id: true,
            name: true,
            email: true,
          },
        },
      },
    });

    if (!report) {
      return res.status(404).json({
        error: "Report not found",
      });
    }

    // Authorization check
    if (user.role === "CITIZEN") {
      // Citizens can only access reports from their state
      if (!report.state || !user.state || report.state !== user.state) {
        return res.status(403).json({
          error: "Forbidden: insufficient permissions",
        });
      }
      // If citizen has a district, report must match district too
      if (user.district && report.district !== user.district) {
        return res.status(403).json({
          error: "Forbidden: insufficient permissions",
        });
      }
    }
    // Administrators can access any report

    res.json(report);
  } catch (error) {
    console.error("Error fetching report:", error);
    res.status(500).json({ error: "Internal server error" });
  }
});

app.listen(PORT, () => {
  console.log(`CivicLens backend running at http://localhost:${PORT}`);
});